{
    "terminal.integrated.suggest.enabled": true,
    "terminal.integrated.shellIntegration.enabled": true,
    "terminal.integrated.suggest.quickSuggestions": true,
    "terminal.integrated.suggest.suggestOnTriggerCharacters": true,
    "editor.fontFamily": "Arial",
    "editor.autoClosingBrackets": "never",
    "editor.autoClosingComments": "never",
    "editor.autoClosingQuotes": "never",
    "editor.fontSize": 16,
    "editor.parameterHints.enabled": true,
    "editor.lightbulb.enabled": "off",
    "editor.fontLigatures": false,
    "files.exclude": {
        "**/.DS_Store": false,
        "**/.git": false,
        "**/.hg": false,
        "**/.svn": false,
        "**/Thumbs.db": false
    },
    "explorer.confirmDragAndDrop": false,
    "explorer.compactFolders": false,
    "explorer.confirmDelete": false,
    "workbench.colorTheme": "Visual Studio Dark",
    "workbench.startupEditor": "none",
    "workbench.preferredHighContrastColorTheme": "Visual Studio Dark",
    "workbench.editor.enablePreview": false,
    "workbench.iconTheme": null,
    "workbench.editor.enablePreviewFromQuickOpen": false,
    "window.zoomLevel": 1,
    "window.commandCenter": false,
    "editor.cursorBlinking": "solid",
    "editor.cursorStyle": "line",
    "editor.showFoldingControls": "never",
    "editor.overviewRulerBorder": false,
    "editor.tabCompletion": "on",
    "terminal.integrated.fontFamily": "monospace",
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "extensions.ignoreRecommendations": true,
    "python.defaultInterpreterPath": "/usr/local/bin/python3",
    "terminal.integrated.cursorStyle": "underline",
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.scrollback": 250,
    "terminal.integrated.stickyScroll.enabled": false,
    "editor.stickyScroll.enabled": true,
    "workbench.tree.enableStickyScroll": false,
    "workbench.tree.renderIndentGuides": "always",
    "python.createEnvironment.trigger": "off",
    "editor.minimap.size": "fit",

    "workbench.colorCustomizations": {
        "terminal.background": "#000000",
        "terminal.foreground": "#b8c4c9",
        "editor.background": "#000000",
        "sideBar.background": "#000000",
        "activityBar.background": "#000000",
        "activityBar.activeBackground": "#000000",
        "activityBar.foreground": "#ffffff",
        "activityBarBadge.foreground": "#15202b",
        "titleBar.activeBackground": "#000000",
        "titleBar.inactiveBackground": "#00000099",
        "titleBar.activeForeground": "#e7e7e7",
        "editorGroupHeader.tabsBackground": "#000000",
        "tab.activeBackground": "#303030",
        "tab.activeForeground": "#ffffff",
        "tab.inactiveBackground": "#000000",
        "focusBorder": "#ff0000",
        "editorGroup.border": "#fffb0080",
        "editor.lineHighlightBorder": "#fffb0060",
        "quickInput.background": "#000000",
        "quickInput.foreground": "#FFFFFF",
        "quickInputTitle.background": "#000000e0",
        "editorSuggestWidget.background": "#00000070",
        "editorSuggestWidget.foreground": "#FFFFFF",
        "editorSuggestWidget.border": "#ffffff00",
        "editorSuggestWidget.selectedBackground": "#fffb0070",
        "editorHoverWidget.background": "#00000070",
        "editorHoverWidget.border": "#ffffff00",
        "editorSignatureHelp.background": "#000000",
        "editorSignatureHelp.foreground": "#FFFFFF",
        "editorSignatureHelp.border": "#ffffff00",
        "editorCursor.foreground": "#00FF00FF",
        "commandCenter.border": "#e7e7e799",
        "sash.hoverBorder": "#1a1a1a",
        "statusBar.background": "#000000",
        "statusBar.foreground": "#e7e7e7",
        "statusBarItem.hoverBackground": "#1a1a1a",
        "statusBarItem.remoteBackground": "#782828",
        "statusBarItem.remoteForeground": "#e7e7e7",
        "titleBar.inactiveForeground": "#e7e7e799",
        "commandCenter.foreground": "#e7e7e7",
        "statusBar.debuggingBackground": "#000000",
        "statusBar.debuggingForeground": "#e7e7e7"
    },
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false
    },
    "chat.checkpoints.enabled": false,
    "github.copilot.nextEditSuggestions.enabled": true,
    "terminal.integrated.initialHint": false,
    "editor.minimap.enabled": false,
    "database-client.openResultsAsVertically": false,
    "chat.viewSessions.orientation": "stacked",
    "workbench.browser.showInTitleBar": true,
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "csv.maxFileSizeMB": 0,
    "peacock.affectStatusBar": true,
    "peacock.affectActivityBar": false,
    "peacock.affectTitleBar": true,
    "workbench.experimental.modernUI": false,
    "update.showReleaseNotes": false,
    "extensions.autoUpdate": "off",
    "update.mode": "none",
    "network.meteredConnection": "on",
    "security.workspace.trust.banner": "always"
}
